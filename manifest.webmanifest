{
    "name": "Bin Calendar",
    "short_name": "Bins",
    "description": "See which bins are due for collection this week.",
    "start_url": "./index.html",
    "scope": "./",
    "display": "standalone",
    "orientation": "portrait",
    "background_color": "#f4f6f8",
